<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/eden_background_gradient"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="10dp"
        android:paddingEnd="15dp"
        android:paddingBottom="82dp">

        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="52dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NxEmu"
                    android:textColor="@color/eden_on_background"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:text="Android"
                    android:textColor="@color/eden_on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="220dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <ImageButton
                android:id="@+id/button_view_mode"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/eden_button"
                android:contentDescription="View mode"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="10dp"
                android:scaleType="center"
                android:src="@drawable/nx_ic_view_grid" />

            <ImageButton
                android:id="@+id/button_sort_mode"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/eden_button"
                android:contentDescription="Sort and filter"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="10dp"
                android:scaleType="center"
                android:src="@drawable/nx_ic_filter" />

            <Button
                android:id="@+id/button_driver_manager"
                style="@style/NxEmuEdenIconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="GPU"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/button_settings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/eden_button"
                android:contentDescription="Settings"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="10dp"
                android:scaleType="center"
                android:src="@drawable/nx_ic_settings"
                android:visibility="gone" />

            <Button
                android:id="@+id/button_more"
                style="@style/NxEmuEdenIconButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:contentDescription="More"
                android:text="•••" />

            <Space
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:importantForAccessibility="no" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/top_actions"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/eden_search_bg"
            android:paddingStart="18dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="0dp"
                android:contentDescription="Search"
                android:src="@drawable/nx_ic_search" />

            <EditText
                android:id="@+id/search_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="45dp"
                android:layout_marginEnd="78dp"
                android:background="@android:color/transparent"
                android:fontFamily="monospace"
                android:hint="Search games"
                android:imeOptions="flagNoFullscreen"
                android:inputType="text"
                android:maxLines="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:textColor="@color/eden_on_background"
                android:textColorHint="@color/eden_on_surface_variant"
                android:textSize="14sp" />

            <Button
                android:id="@+id/button_clear_search"
                style="@style/NxEmuEdenIconButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="40dp"
                android:contentDescription="Clear search"
                android:text="×"
                android:visibility="gone" />

            <Button
                android:id="@+id/button_refresh_covers"
                style="@style/NxEmuEdenIconButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="0dp"
                android:contentDescription="Refresh covers"
                android:text="⟳"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/selected_game"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/eden_on_surface_variant"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/shell_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/eden_on_surface_variant"
            android:textSize="11sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/notice_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="112dp"
                android:textColor="@color/eden_on_background"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/game_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fadeScrollbars="true"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="12dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/diagnostics_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/status_view"
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:background="@drawable/eden_panel"
                android:fontFamily="monospace"
                android:padding="14dp"
                android:scrollbars="vertical"
                android:textColor="@color/eden_on_background"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_scan_default"
            style="@style/NxEmuEdenFabSecondary"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="扫描" />

        <Button
            android:id="@+id/button_open_folder"
            style="@style/NxEmuEdenFabSecondary"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:text="文件夹" />

        <Button
            android:id="@+id/button_input_settings"
            style="@style/NxEmuEdenFabSecondary"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:text="输入"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_game_properties"
            style="@style/NxEmuEdenFabSecondary"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="属性"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_run_selected"
            style="@style/NxEmuEdenFabPrimary"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:text="启动" />
    </LinearLayout>
</FrameLayout>
