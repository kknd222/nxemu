<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/eden_background_gradient"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/eden_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/badge"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/eden_badge"
            android:gravity="center"
            android:text="INFO"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Game Info"
                android:textColor="@color/eden_on_background"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingTop="4dp"
                android:textColor="@color/eden_on_surface_variant"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:paddingTop="4dp"
                android:textColor="@color/eden_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/button_copy"
            style="@style/NxEmuEdenButton"
            android:layout_width="132dp"
            android:layout_height="48dp"
            android:text="复制诊断" />

        <Button
            android:id="@+id/button_back"
            style="@style/NxEmuEdenButton"
            android:layout_width="110dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:text="返回" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/items_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />
</LinearLayout>
