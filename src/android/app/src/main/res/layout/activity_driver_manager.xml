<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/eden_background_gradient"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/eden_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:background="@drawable/eden_badge"
            android:gravity="center"
            android:text="GPU"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GPU Driver Manager"
                android:textColor="@color/eden_on_background"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textColor="@color/eden_on_surface_variant"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="5dp"
                android:textColor="@color/eden_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_install_zip"
                style="@style/NxEmuEdenButtonPrimary"
                android:layout_width="98dp"
                android:layout_height="36dp"
                android:text="安装ZIP" />

            <Button
                android:id="@+id/button_auto_install"
                style="@style/NxEmuEdenButton"
                android:layout_width="98dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="自动" />

            <Button
                android:id="@+id/button_back"
                style="@style/NxEmuEdenButton"
                android:layout_width="82dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="返回" />

            <Button
                android:id="@+id/button_more"
                style="@style/NxEmuEdenButton"
                android:layout_width="82dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="更多" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/driver_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/status_view"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/eden_panel"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:scrollbars="vertical"
        android:textColor="@color/eden_on_background"
        android:textSize="9sp" />
</LinearLayout>
